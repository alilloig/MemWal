# Walrus Memory Palace — all values are optional; the defaults work.

# Relayer the SDK talks to. Default in dev: the page's own origin, so the
# vite dev-server proxy handles CORS (deployed relayers only allow their own
# web origins). Default in production builds: https://relayer.memory.walrus.xyz
#VITE_MEMWAL_SERVER_URL=

# Where the dev-server proxy forwards relayer calls (Node-side, dev only).
# Set empty to disable the proxy. Default: https://relayer.memory.walrus.xyz
#DEV_BACKEND_PROXY_TARGET=https://relayer.memory.walrus.xyz

# Sui network used for on-chain blob enumeration: mainnet (default) | testnet.
# Applies to manual setup and first load; a one-click connect takes the network
# from the dashboard callback and persists it.
#VITE_SUI_NETWORK=mainnet

# Walrus Memory dashboard that hosts the one-click connect flow (/connect/app).
# Point at http://localhost:5173 to test against a locally-run dashboard.
# Default: https://memory.walrus.xyz
#VITE_MEMWAL_DASHBOARD_URL=
