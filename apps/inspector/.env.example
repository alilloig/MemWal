# Relayer the inspector (and the SDK snippets it shows) talk to.
VITE_MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz

# Local dev note: deployed relayers' CORS allowlists have no localhost entry,
# so direct browser calls from `pnpm dev` are blocked. Work around it with the
# dev-server proxy: set DEV_BACKEND_PROXY_TARGET to the relayer origin and
# VITE_MEMWAL_SERVER_URL to this dev server's own origin.
#DEV_BACKEND_PROXY_TARGET=https://relayer.memory.walrus.xyz
#VITE_MEMWAL_SERVER_URL=http://localhost:5183

# Network used for on-chain blob enumeration: mainnet | testnet.
# Overwritten by the network the dashboard reports during one-click connect.
VITE_SUI_NETWORK=mainnet

# Walrus Memory dashboard that hosts the one-click connect flow
# (/connect/app). Point at http://localhost:5173 to test against a local
# `pnpm --filter @memwal/app dev`.
VITE_MEMWAL_DASHBOARD_URL=https://memory.walrus.xyz
